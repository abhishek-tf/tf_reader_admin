#!/usr/bin/env bash
# pre-commit hook for tf_reader_admin. Copy to .githooks/pre-commit.
#
# Activate once per clone:   git config core.hooksPath .githooks
set -euo pipefail

fail() { echo "" >&2; echo "COMMIT REJECTED" >&2; echo "  $1" >&2; echo "" >&2; exit 1; }

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# --- 1. never commit a secret -------------------------------------------------
if grep -qE '(^|/)\.env' <<<"$staged"; then
  fail ".env is staged. It holds local secrets. Unstage it:
      git restore --staged .env"
fi
if grep -qE '\.(pem|key|p12|jks)$' <<<"$staged"; then
  fail "A key file is staged. Those must never enter the repo."
fi

# --- 2. never persist a token -------------------------------------------------
# The one security rule that matters most in a browser app.
if git diff --cached -U0 | grep -qE '^\+.*(localStorage|sessionStorage)\.setItem\([^)]*[Tt]oken'; then
  fail "A staged line stores a token in localStorage or sessionStorage. An XSS reads it.
  Keep the access token in memory, in a context. See CLAUDE.md."
fi

# --- 3. format, so nobody argues about it ------------------------------------
fmt=$(grep -E '\.(js|jsx|json|css|md|html)$' <<<"$staged" || true)
if [ -n "$fmt" ] && [ -f package.json ]; then
  if ! npx --no-install prettier --write $fmt >/dev/null 2>&1; then
    echo "NOTE: prettier is not installed yet. Run: npm install -D prettier" >&2
  else
    while IFS= read -r f; do [ -f "$f" ] && git add -- "$f"; done <<<"$fmt"
  fi
fi

# --- 4. lint only what changed ------------------------------------------------
lintable=$(grep -E '\.(js|jsx)$' <<<"$staged" || true)
if [ -n "$lintable" ] && [ -f eslint.config.js ]; then
  if ! npx --no-install eslint $lintable; then
    fail "ESLint found errors in the staged files. Fix them, or say why the rule is wrong
  and we will remove it from eslint.config.js. Do not add eslint-disable without a reason."
  fi
fi

# --- 5. leftover debugging ----------------------------------------------------
if git diff --cached -U0 | grep -qE '^\+\s*(console\.log|debugger)'; then
  echo "NOTE: a console.log or debugger is being committed." >&2
fi

exit 0
